{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wx-clawbot-notify-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "<YOUR_CLOUDFLARE_ACCOUNT_ID>",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wx-clawbot-notify-webhook",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "<YOUR_R2_BUCKET_NAME>"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY",
        "class_name": "Gateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Gateway"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
