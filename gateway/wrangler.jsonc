{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wx-clawbot-notify-webhook",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PUBLIC_ORIGIN": "https://wx-clawbot-notify-webhook.goujy459.workers.dev",
    "GITHUB_REPO": "MARYCOMPLEX/today"
  },
  "account_id": "810b967e7c471f41055789973fa72b9f",
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wx-clawbot-notify-webhook",
      "database_id": "d9400d54-cd44-44c7-96f0-a799f6e16603",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "wx-clawbot-notify-webhook-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GATEWAY",
        "class_name": "Gateway"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Gateway"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
